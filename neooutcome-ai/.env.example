# Public frontend configuration only. Never put service_role keys here.
VITE_ML_API_URL=http://127.0.0.1:8000

# Optional Supabase browser client values. These are public identifiers,
# but access is still protected by Supabase Auth and Row Level Security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
